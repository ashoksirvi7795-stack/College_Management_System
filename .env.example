# ==========================================================
# College Management System - Environment Variables
# ==========================================================

# Server Configuration
PORT=5050
NODE_ENV=development

# Database Dialect: 'mysql' (default) or 'sqlite'
DB_DIALECT=mysql

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=college_db

# SQLite Fallback File (used if MySQL is not available)
SQLITE_DB_PATH=./college_db.sqlite

# JWT Secret
JWT_SECRET=super_secret_college_management_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
